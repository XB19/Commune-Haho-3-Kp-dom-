{
  "name": "commune-haho3-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "API (Express + PostgreSQL) et tableau de bord d'administration de la Commune Haho 3 – Kpédomé",
  "scripts": {
    "dev": "concurrently -k -n api,admin -c yellow,magenta \"npm:dev:api\" \"npm:dev:admin\"",
    "dev:api": "node --env-file-if-exists=../.env --watch-path=server --watch-path=content server/index.js",
    "dev:admin": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=../.env server/index.js",
    "db:init": "node --env-file-if-exists=../.env server/init.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "cookie-parser": "^1.4.7",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@tailwindcss/vite": "^4.1.7",
    "tailwindcss": "^4.1.7",
    "vite": "^6.3.5",
    "concurrently": "^10.0.6"
  }
}
