# Copiez ce fichier en « .env » puis complétez les valeurs.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=haho3

PORT=4000
# Longue chaîne aléatoire (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

ADMIN_EMAIL=communehaho3@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# Mettez « true » dès que le site est servi en HTTPS (cookie de session sécurisé).
COOKIE_SECURE=false
# Docker uniquement : port publié sur la machine hôte.
APP_PORT=4000
